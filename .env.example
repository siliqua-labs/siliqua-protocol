# Siliqua environment template. Copy to .env (git-ignored) and fill in.
# "Set in" says where a variable lives: local .env, a Railway service, or Vercel.
# Railway and Vercel keep their own copy of what they need. Never commit values.
# Lines starting with "# " followed by a name are optional and have a default in code.


# ============================ Database ============================

# Local Docker Postgres (docker compose up -d). Set in: local.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://siliqua:<POSTGRES_PASSWORD>@127.0.0.1:5432/siliqua

# Supabase session pooler string. Set in: local, only to apply migrations and to copy into the
# Railway services as their DATABASE_URL. Keep it separate from DATABASE_URL above.
SUPABASE_DATABASE_URL=


# ============================ Chain ============================
# Values come from packages/chain (verified flags). CHAIN_ENV picks the entry there.
# Set in: local, Railway services that talk to the chain, Vercel for the web.

CHAIN_ENV=
CHAIN_ID=
RPC_URL=
ORACLE_ADDRESS=
FACTORY_ADDRESS=

# ============================ Wallets: testnet deploy ============================
# Public addresses only, never a private key. Read by contracts/script/DeployTestnet.s.sol.
# The deploying wallet runs the script, then hands oracle admin, guardian and factory owner to ADMIN
# (one EOA stands in for the multisig on testnet). The deployer key stays in a forge keystore
# (cast wallet import). ADMIN must differ from the deployer; the hand-over has no acceptance step.
ADMIN=

# tUSDG on the testnet, see packages/chain.
TOKEN=0x3A37C1D137e02e04E1CC1e4a7dB0B4628C762b4e
# The three oracle operators. Each signs only; each runs in its own Railway project with its own key.
OPERATOR_1=
OPERATOR_2=
OPERATOR_3=
# Registered on MarketFactory.setKeeper. Its key goes to the market-keeper service.
KEEPER=
# FeeRouter recipients: 50% buyback wallet, 30% treasury, 20% operators.
FEE_BUYBACK=
FEE_TREASURY=
FEE_OPERATORS=
# The relayer address is not needed by the script. Only its key (RELAYER_PRIVATE_KEY) is, in Railway.

# ============================ Wallets: mainnet deploy ============================
# Read by contracts/script/DeployMainnet.s.sol; see docs/mainnet-cutover.md. Public addresses and the
# bet cap only. Use new wallets, not the testnet ones.
MAINNET_TOKEN=
MAINNET_SAFE=
MAINNET_TIMELOCK=
MAINNET_OPERATOR_1=
MAINNET_OPERATOR_2=
MAINNET_OPERATOR_3=
MAINNET_KEEPER=
MAINNET_FEE_BUYBACK=
MAINNET_FEE_TREASURY=
MAINNET_FEE_OPERATORS=
# Bet cap in whole tokens; the factory scales it by the token's decimals.
MAINNET_BET_CAP_TOKENS=


# ============================ Railway: worker ============================
# One container runs the price collector, index engine and watchdog (deploy/worker.sh).

# price-collectors. A provider runs only when its flag is "true".
# Vast.ai and RunPod terms bar index use without a written agreement. There is none; the owner
# accepted the risk on 2026-11-27 (docs/sources.md).
COLLECT_INTERVAL_SECONDS=600
COLLECTOR_RUNPOD_ENABLED=false
RUNPOD_API_KEY=
COLLECTOR_VASTAI_ENABLED=false
VASTAI_API_KEY=
COLLECTOR_LAMBDA_ENABLED=false
COLLECTOR_TEXEL_ENABLED=false
COLLECTOR_AKASH_ENABLED=false
COLLECTOR_HYPERSTACK_ENABLED=false
COLLECTOR_SALAD_ENABLED=false
COLLECTOR_VERDA_ENABLED=false
COLLECTOR_NEBIUS_ENABLED=false
COLLECTOR_TENSORDOCK_ENABLED=false
TENSORDOCK_API_KEY=

# index-engine
ENGINE_INTERVAL_SECONDS=300

# watchdog. ALERT_WEBHOOK_URL receives a JSON POST {"text": "..."}; empty means log only.
WATCHDOG_INTERVAL_SECONDS=600
WATCHDOG_WINDOW_HOURS=720
WATCHDOG_SOURCE_MAX_AGE_SECONDS=1800
ALERT_WEBHOOK_URL=


# ============================ Railway: api ============================

PORT=8080
# Report board and oracle page. ORACLE_OPERATORS is a comma-separated list of operator addresses.
ORACLE_OPERATORS=
ORACLE_TOLERANCE_BPS=


# ============================ Railway: later, after the testnet deploy ============================

# relayer, indexer and market-keeper run from deploy/Dockerfile.chain; SERVICE picks the role
# (relayer, indexer or market-keeper). See docs/testnet-deploy.md.
# SERVICE=

# relayer (services/api, relayer-main.ts). Pays gas; holds nothing else.
RELAYER_PRIVATE_KEY=
# RELAYER_INTERVAL_SECONDS=30

# indexer. FACTORY_ADDRESS (above) turns on market events; set it from the first run.
# INDEXER_START_BLOCK=0
# INDEXER_CONFIRMATIONS=0
# INDEXER_MAX_RANGE=1000
# INDEXER_KEEP_BLOCKS=256
# INDEXER_INTERVAL_SECONDS=5

# market-keeper. The key must be registered with MarketFactory.setKeeper.
KEEPER_PRIVATE_KEY=
MARKET_INDEX_IDS=
# Unix time of one weekly close; later closes are this plus whole weeks.
MARKET_CLOSE_ANCHOR=
# KEEPER_INTERVAL_SECONDS=60


# ============================ Railway: oracle-node (one service per operator) ============================

# Separate Railway project from api and worker, so these keys never sit next to DATABASE_URL.
# RAILWAY_DOCKERFILE_PATH=deploy/Dockerfile.oracle-node
# A dedicated signing wallet: no funds, used for nothing else. The relayer pays gas.
SIGNING_KEY=
# Public api of the Railway project that runs api (no trailing path).
API_URL=
# Same values as the api and the contract; CHAIN_ID stays unverified until the owner confirms it.
# CHAIN_ID and ORACLE_ADDRESS (Chain section above).
# Comma-separated index slugs registered on the oracle, for example h100,a100.
ORACLE_INDEX_SLUGS=
# ORACLE_INTERVAL_SECONDS=300


# ============================ Vercel: web ============================

# Public address of the site, for canonical and social links. Optional; defaults to
# https://siliqua.tech. Set in: Vercel.
# SITE_URL=
# Base URL of the Railway api. Empty means the pages show labelled sample data.
API_BASE_URL=
# Markets are real only when CHAIN_ENV, RPC_URL and FACTORY_ADDRESS (Chain section) are all set.
