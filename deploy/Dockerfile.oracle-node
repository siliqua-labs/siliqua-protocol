# One oracle operator. Build context is the repository root (leave Root Directory empty on the Railway service).
# Set RAILWAY_DOCKERFILE_PATH=deploy/Dockerfile.oracle-node on the service.
FROM python:3.13-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages packages
# The workspace lists every worker, so uv needs all their manifests to read the lock file.
COPY workers workers
RUN uv sync --frozen --no-dev --package oracle-node

# Not "operator": Debian already ships a system group with that name.
RUN useradd --system --no-create-home oraclenode
USER oraclenode
CMD ["python", "-m", "oracle_node"]
