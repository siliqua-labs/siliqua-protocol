# Build context is the repository root (leave Root Directory empty on the Railway service).
# Node runs the TypeScript source directly, so nothing is compiled.
# The image also carries the indexer and the market keeper; deploy/api.sh starts them, and the
# relayer, beside the api when RUN_INDEXER, RUN_RELAYER and RUN_KEEPER are "true" (one service
# instead of four on a small plan).
FROM node:24-slim

ENV NODE_ENV=production
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY services/api/package.json services/api/
COPY services/indexer/package.json services/indexer/
COPY services/market-keeper/package.json services/market-keeper/
COPY packages/chain/package.json packages/chain/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --prod \
    --filter @siliqua/api... --filter @siliqua/indexer... --filter @siliqua/market-keeper...

COPY services/api services/api
COPY services/indexer services/indexer
COPY services/market-keeper services/market-keeper
COPY deploy/api.sh deploy/api.sh

USER node
WORKDIR /app
CMD ["bash", "deploy/api.sh"]
