      "quotes": {"a": 2000000, "b": 2000000, "c": 2000000, "d": 2000000, "e": 2060000},
      "expected": {"value": 2000000, "valid_sources": 5, "dropped": []}
    },
    {
      "name": "quote one micro-USD past the bound is dropped",
      "quotes": {"a": 2000000, "b": 2000000, "c": 2000000, "d": 2000000, "e": 2060001},
      "expected": {"value": null, "valid_sources": 4, "dropped": ["e"]}
    },
    {
      "name": "median of an even count rounds half up",
      "quotes": {"a": 1000000, "b": 1000000, "c": 1000000, "d": 1000001, "e": 1000001, "f": 1000001},
      "expected": {"value": 1000001, "valid_sources": 6, "dropped": []}
    },
    {
      "name": "no quotes",
      "quotes": {},
      "expected": {"value": null, "valid_sources": 0, "dropped": []}
    }
  ],
