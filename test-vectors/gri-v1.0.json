      "expected": {"value": 2500000, "valid_sources": 5, "dropped": []}
    },
    {
      "name": "one outlier dropped, five remain",
      "quotes": {"a": 2500000, "b": 2520000, "c": 2480000, "d": 2510000, "e": 2490000, "f": 3900000},
      "expected": {"value": 2500000, "valid_sources": 5, "dropped": ["f"]}
    },
    {
      "name": "four sources is below the minimum",
      "quotes": {"a": 2500000, "b": 2520000, "c": 2480000, "d": 2510000},
      "expected": {"value": null, "valid_sources": 4, "dropped": []}
    },
    {
      "name": "minimum counted after the outlier filter",
      "quotes": {"a": 2500000, "b": 2510000, "c": 2490000, "d": 2505000, "e": 5000000},
      "expected": {"value": null, "valid_sources": 4, "dropped": ["e"]}
    },
    {
      "name": "MAD is zero, 1 percent floor keeps a near quote",
